APP_NAME="Price Alert System"
APP_ENV=testing
APP_KEY=base64:MhwnKAvSs/JnEAV/jwrtZWP+O5s3MxPqS3XzvdtXMUQ=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=price_alerts
DB_USERNAME=price_alerts
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=rabbitmq

CACHE_STORE=redis


REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=redis_secret
REDIS_PORT=6379
# Deliberately separate from dev's db0/db1 (see config/database.php) so the
# test suite — which exercises real Redis atomicity/failure behavior rather
# than mocking it — never shares keyspace with, or clobbers, dev/demo data.
REDIS_DB=2
REDIS_CACHE_DB=3

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="alerts@price-alerts.test"
MAIL_FROM_NAME="${APP_NAME}"

PRICE_MATCH_BATCH_SIZE=1000
PRICE_MAX_DRAIN_PASSES=5000
ALERT_RETENTION_DAYS=30
NOTIFICATION_REDISPATCH_AFTER=60

PRICE_TICK_ENABLED=false
PRICE_PROVIDER=goldapi
GOLDAPI_IO_API_KEY=test-key
GOLDAPI_IO_BASE_URL=https://www.goldapi.io/api
GOLDAPI_IO_TIMEOUT=5
GOLDAPI_IO_PROXY_ENABLED=false
GOLDAPI_IO_PROXY_URL=socks5h://127.0.0.1:10808

