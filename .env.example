# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="Price Alert System"
APP_ENV=local
# Leave blank — `php artisan key:generate` fills it in. See README step 2.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ─── Container user ───────────────────────────────────────────────────────────
# UID/GID are baked into the php image so bind-mounted files stay writable from
# the host. Set these to your own `id -u` / `id -g` if they are not 1000.
# USR/GRP must match `user`/`group` in docker/php/www.conf, which cannot
# interpolate env vars.
USR=appuser
GRP=appuser
UID=1000
GID=1000

# ─── Host port mappings ───────────────────────────────────────────────────────
# Deliberately off the default ports so this stack can run alongside a local
# postgres/redis/rabbitmq without colliding.
NGINX_PORT=8000
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
RABBITMQ_HOST_PORT=5673
RABBITMQ_MANAGEMENT_HOST_PORT=15673
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database (source of truth) ───────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=price_alerts
DB_USERNAME=price_alerts
DB_PASSWORD=secret

# ─── Session / cache / queue ──────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=redis
QUEUE_CONNECTION=rabbitmq

# ─── Redis ────────────────────────────────────────────────────────────────────
# REDIS_DB holds the alert index (ZSETs); REDIS_CACHE_DB holds the cache,
# including the last known price. Two databases so `cache:clear` can never
# wipe the index.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=redis_secret
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ─── Mail ─────────────────────────────────────────────────────────────────────
# Defaults to the bundled Mailpit container — no account needed, read mail at
# http://localhost:8025. MAIL_MAILER must be set: config/mail.php falls back to
# the `log` driver when it is absent, which writes mail to storage/logs and
# still records it as sent.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="alerts@price-alerts.test"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Price provider ───────────────────────────────────────────────────────────
# GoldAPI.io. The free tier allows ~100 requests per MONTH, which is why
# `price:tick` is not on the scheduler — see README "Price feed".
PRICE_TICK_ENABLED=false
PRICE_PROVIDER=goldapi
GOLDAPI_IO_API_KEY=
GOLDAPI_IO_BASE_URL=https://www.goldapi.io/api
GOLDAPI_IO_TIMEOUT=5
# Optional egress proxy, for networks that block the provider.
GOLDAPI_IO_PROXY_ENABLED=false
GOLDAPI_IO_PROXY_URL=socks5h://127.0.0.1:10808

# ─── Alert engine tuning ──────────────────────────────────────────────────────
# Ids claimed per Lua call, per direction. Hard ceiling is 6553: AlertClaimer
# binds 5 parameters per notification row and claims up to 2x this value per
# pass, against Postgres' 65535-parameter statement limit.
PRICE_MATCH_BATCH_SIZE=1000
# Safety bound on the chunk-and-requeue drain chain (passes x batch size).
PRICE_MAX_DRAIN_PASSES=5000
# Days a triggered alert is retained before alerts:prune removes it.
ALERT_RETENTION_DAYS=30
# Seconds a notification may sit Pending before it is treated as a lost
# publish and re-dispatched.
NOTIFICATION_REDISPATCH_AFTER=60
